<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="cloudnest.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Cloudnest\Cloudnest">
    </Installer>
    <PackageInformation
        PackageName="Cloudnest"
        PackageDisplayName="Cloudnest"
        PublisherName="CN=Cloudnest"
        PublisherDisplayName="Cloudnest"
        Version="0.1.0.0"
        PackageDescription="Cloudnest 雲栖 — simple cloud backup">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.cloudnest.desktop"
                Description="Cloudnest 雲栖 — simple cloud backup"
                DisplayName="Cloudnest"
                ExecutableName="cloudnest.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Cloudnest</DisplayName>
            <PublisherDisplayName>Cloudnest</PublisherDisplayName>
            <Description>Cloudnest 雲栖 — simple cloud backup</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="cloudnest.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
